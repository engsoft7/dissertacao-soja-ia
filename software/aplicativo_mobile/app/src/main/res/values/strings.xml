    <string name="alertas_pulverizacao_lugar">Avisar, no máximo uma vez por dia, a próxima janela de ao menos 2 horas boas para pulverizar em %1$s, pelos critérios da Embrapa Soja.</string>
    <string name="alertas_preco">Preço da saca</string>
    <string name="alertas_preco_explicacao">Avisar quando a cotação do dia na praça chegar ao preço-alvo. Avisa de novo só depois de a cotação cair abaixo dele.</string>

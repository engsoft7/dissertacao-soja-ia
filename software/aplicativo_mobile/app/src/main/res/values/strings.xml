    <string name="alertas_voltar">Voltar ao Resumo</string>
    <string name="alertas_explicacao">Ligue o que quer receber. O celular confere a cada 3 horas, com internet, mesmo com o app fechado, e avisa por notificação. O Android pode atrasar a conferência para poupar bateria.</string>
